{
    "name": "@lotso-trading/bot",
    "version": "1.0.0",
    "exports": "./src/main.ts",
    "imports": {
        "@lotso-trading/shared": "npm:@lotso-trading/shared@1.0.0-develop.6",
        "@polymarket/clob-client": "npm:@polymarket/clob-client@^5.8.1",
        "ethers": "npm:ethers@^6.17.0",
        "viem": "npm:viem@^2.58.1",
        "axios": "npm:axios@^1.21.1",
        "ws": "npm:ws@^8.23.0",
        "zod": "npm:zod@^4.6.7"
    },
    "compilerOptions": {
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "noUncheckedIndexedAccess": true
    },
    "tasks": {
        "dev": "deno run -A --watch src/main.ts",
        "start": "deno run -A src/main.ts",
        "test": "deno test -A tests/",
        "test-clob": "deno run -A --env src/scripts/test-clob-connection.ts",
        "lint": "deno run -A npm:@biomejs/biome check .",
        "format": "deno run -A npm:@biomejs/biome format --write .",
        "check": "deno check src/main.ts"
    }
}
